  "steps": [
    {
      "id": "e49451a6-3c4a-456b-8a52-4a41b0d443c0",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": null,
      "position": 0,
      "start_time": null,
      "display_text": "Cut the eggplant, peppers, tomatoes, and onion into bite-sized chunks."
    },
    {
      "id": "5a2339cf-7ef7-4673-b754-7c2accbc4eb4",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": 600,
      "position": 1,
      "start_time": null,
      "display_text": "Salt the eggplant and let sit for 10 minutes, then pat dry."
    },
    {
      "id": "c64b412e-aac0-4edc-af47-84a2351f68d9",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": 480,
      "position": 2,
      "start_time": null,
      "display_text": "Heat oil in a wide pan and fry the eggplant until softened and lightly golden, about 8 minutes."
    },
    {
      "id": "f5bf1066-f0d2-4648-8ebe-2dbf0e403db5",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": 300,
      "position": 3,
      "start_time": null,
      "display_text": "Add the onion and peppers, and cook for another 5 minutes."
    },
    {
      "id": "fea784b6-f9d9-4641-be46-ae3182261a15",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": 840,
      "position": 4,
      "start_time": null,
      "display_text": "Stir in the tomatoes, garlic, and khmeli-suneli, cover, and simmer for 12-15 minutes until everything is soft and stewed together."
    },
    {
      "id": "981a7ebb-340f-4885-852b-e8ec24d8da31",
      "dish_id": "04c779af-d709-441b-960e-3e65f2f6e8eb",
      "end_time": null,
      "position": 5,
      "start_time": null,
      "display_text": "Season with salt, stir in cilantro, and serve warm or at room temperature."
    }
  ],

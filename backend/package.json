{
  "name": "foodmatch-backend",
  "version": "1.0.0",
  "description": "FoodMatch backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "cleanup:mealdb": "ts-node src/scripts/cleanupMealDbDishes.ts",
    "fix:sourceType": "ts-node src/scripts/fixMissingSourceType.ts",
    "migrate:swipe-indexes": "ts-node src/scripts/migrateSwipeIndexes.ts",
    "audit:user-emails": "ts-node src/scripts/auditUserEmails.ts",
    "migrate:mark-existing-users-verified": "ts-node src/scripts/migrateMarkExistingUsersVerified.ts",
    "audit:ingredients": "ts-node src/scripts/auditIngredients.ts --source mongo",
    "test:exclusions": "ts-node src/scripts/testExclusionMatcher.ts",
    "audit:ingredients:files": "ts-node src/scripts/auditIngredients.ts --source files",
    "import:ingredients": "ts-node src/scripts/importIngredients.ts",
    "test:pair-recommendations": "ts-node src/scripts/testPairRecommendationService.ts",
    "inspect:recommendations": "ts-node src/scripts/inspectRecommendationState.ts",
    "test:recommendation-observability": "ts-node src/scripts/testRecommendationObservability.ts",
    "test:pair-filter-flow": "ts-node src/scripts/testPairFilterFlow.ts",
    "test:pair-session-lifecycle": "ts-node src/scripts/testPairSessionLifecycle.ts",
    "fix:filter-preset-indexes": "ts-node src/scripts/fixFilterPresetIndexes.ts",
    "test:pair-deck-idempotency": "ts-node src/scripts/testPairDeckIdempotency.ts",
    "test:pair-join-replace": "ts-node src/scripts/testPairJoinReplace.ts",
    "test:pair-continue-invitations": "ts-node src/scripts/testPairContinueInvitations.ts",
    "test:pair-deck-restart": "ts-node src/scripts/testPairDeckRestart.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
